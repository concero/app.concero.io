.user_actions_modal {
	box-sizing: border-box;
	transform: translateY(20px);
	opacity: 0;
	transition: all 0.3s ease-in-out;
	width: 806px;
	height: 880px;
	max-height: 100%;
	max-width: 100% !important;
	margin: 0 !important;
	overflow-y: hidden;
	background-color: var(--color-gray-25) !important;

	@media screen and (width < 1920px) {
		height: 576px;
		width: 806px;
	}
	@media screen and (width < 1280px) {
		height: 686px;
		width: 712px;
	}
	@media screen and (width < 744px) {
		height: 555px;
		width: 343px;
	}

	& > * {
		flex-direction: row;
	}

	/*header of modal*/
	& > div:first-child > h2 {
		font: var(--font-heading-xlarge) !important;
		color: var(--color-gray-700) !important;
	}
}
.wrap_modal {
	z-index: 1000;
	& > * {
		box-sizing: content-box;
		min-height: 500px;
		height: 100vh;
		overflow: auto;
		padding-top: 48px;
		padding-bottom: 96px;
		@media screen and (width < 744px) {
			padding-bottom: 64px;
		}
	}
}
