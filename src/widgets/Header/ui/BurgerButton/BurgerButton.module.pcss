.overlay {
	width: 100vw;
	height: 100vh;
	align-items: center;
	display: flex;
	justify-content: center;
	top: 0;
	left: 0;
	position: fixed;
	bottom: 0;
	z-index: 2;
}
.opened {
	outline: 2px solid var(--color-accent-500) !important;
	outline-offset: 2px !important;
}
.menu_container {
	position: absolute;
	right: 130px;
	top: 60px;
	width: 320px;
	background-color: var(--color-gray-25);
	border-radius: var(--space-l);
	padding: var(--space-m);
	gap: var(--space-m);

	box-shadow: 0px 2px 12px 0px var(--color-gray-100);

	@media (max-width: 743px) {
		width: 100%;
		right: 0;
		top: 56px;
		height: 100vh;
		border-radius: 0;
		box-shadow: none;
	}
}
