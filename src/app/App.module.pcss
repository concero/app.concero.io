.wrap_page {
	/* height: 100%; */
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: var(--space-xl);
	width: 100%;
	/* height: 100%; For disable scrolling and for 100% height */
	padding: var(--space-xl) var(--space-xl) var(--space-xxxxl) var(--space-xl);
	background: linear-gradient(180deg, var(--color-gray-25) 0%, var(--color-gray-50) 30%);

	@media (min-width: 1280px) {
		display: grid;
		grid-template-columns: repeat(24, minmax(0, 1fr));
		grid-template-rows: 1fr auto;
		column-gap: 16px;
	}
	.footer {
		grid-column: 1 / -1;
	}
	@media screen and (width < 744px) {
		padding: var(--space-m) var(--space-m) var(--space-xxxxl) var(--space-m);
	}
}
