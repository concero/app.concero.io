.table {
	width: 100%;
	height: 100%;
	max-width: 100%;
	border-collapse: collapse;
	background-color: var(--color-surface-primary);
	box-sizing: border-box;

	&_header {
		&_row {
			width: 100%;
			height: 50px;
			box-sizing: border-box;
		}

		&_cell {
			box-sizing: border-box;
			width: 100%;
			min-width: 128px;
			height: 50px;
			padding: var(--space-m) var(--space-l) var(--space-m) var(--space-xs);
			color: var(--color-gray-500);
			font: var(--font-heading-small);
			text-align: left;
			border-bottom: 1px solid var(--color-gray-100);
		}
	}

	&_body {
		position: relative;
		overflow: auto;
		width: 100%;
		padding-bottom: var(--space-l);
		&_row {
			&:not(:last-child) {
				/* border-bottom: 1px solid var(--color-gray-100); */
				box-shadow: inset 0 -1px 0 0 var(--color-gray-100);
			}
		}

		&_cell {
			box-sizing: border-box;
			/* min-height: 72px; */
			min-width: 128px;
			gap: 10px;
			padding-top: var(--space-s);
			padding-bottom: var(--space-s);
			@media screen and (width > 743px) {
				padding: var(--space-l) var(--space-l) var(--space-l) var(--space-xs);
			}
		}
		&.with_shadow::after {
			content: '';
			display: flex;
			position: sticky;
			bottom: -25px;
			left: 0;
			right: 0;
			min-height: 25px;
			width: 100%;
			background: linear-gradient(to bottom, transparent, var(--color-gray-25));
			pointer-events: none;
			z-index: 1;
		}
	}
}
